graph TB
    %% ============================================================================
    %% CS336: Distributed Training Topology
    %% ============================================================================

    subgraph CLUSTER["Cluster Topology: DGX H100 (8 GPU per node)"]
        direction TB

        subgraph DGX1["DGX Node 1 (8 × H100 80 GiB)"]
            direction LR
            G1_0["GPU 0"] --- NV1["NVSwitch<br/>900 GB/s bidirectional<br/>all-to-all full bandwidth"]
            G1_1["GPU 1"] --- NV1
            G1_2["GPU 2"] --- NV1
            G1_3["GPU 3"] --- NV1
            G1_4["GPU 4"] --- NV1
            G1_5["GPU 5"] --- NV1
            G1_6["GPU 6"] --- NV1
            G1_7["GPU 7"] --- NV1
        end

        subgraph DGX2["DGX Node 2"]
            direction LR
            G2_0["GPU 0"] --- NV2["NVSwitch"]
            G2_1["GPU 1"] --- NV2
            G2_2["GPU 2"] --- NV2
            G2_3["GPU 3"] --- NV2
            G2_4["GPU 4"] --- NV2
            G2_5["GPU 5"] --- NV2
            G2_6["GPU 6"] --- NV2
            G2_7["GPU 7"] --- NV2
        end

        DGX1 ---|"InfiniBand NDR<br/>400 GB/s per link<br/>8× 200 Gb/s ports"| DGX2
    end

    subgraph PARALLEL["Parallelism Strategy: 3D Hybrid (PTD-P)"]
        direction TB

        subgraph TP["Tensor Parallel (TP)"]
            TP_DESC["Intra-node: within NVLink domain<br/>Shard weight matrices by column/row<br/>ColumnParallel: Y = X @ W_part_i<br/>RowParallel: Y = All-Reduce(X @ W_part_i)<br/>Communication: All-Reduce per layer<br/>Bandwidth: NVLink 900 GB/s (H100)"]
        end

        subgraph PP["Pipeline Parallel (PP)"]
            PP_DESC["Inter-node: across DGX nodes<br/>Model partitioned by layers<br/>Stage 0: layers 0-7 | Stage 1: layers 8-15<br/>Stage 2: layers 16-23 | Stage 3: layers 24-31<br/>Communication: P2P send/recv activations<br/>Bandwidth: InfiniBand 400 GB/s"]
        end

        subgraph DP["Data Parallel (FSDP/ZeRO-3)"]
            DP_DESC["Across all ranks (intra + inter node)<br/>Each rank: 1/N of params/grads/optimizer<br/>All-Gather params before forward<br/>Reduce-Scatter grads after backward<br/>Memory: 4P/N instead of 4P<br/>Communication: interleaved with compute"]
        end
    end

    subgraph RING_ALLREDUCE["Ring All-Reduce Visualization"]
        direction LR
        RA1["GPU 0<br/>grad shard 0"] -->|"send ↷"| RA2["GPU 1<br/>grad shard 1"]
        RA2 -->|"send ↷"| RA3["GPU 2<br/>grad shard 2"]
        RA3 -->|"send ↷"| RA4["GPU 3<br/>grad shard 3"]
        RA4 -->|"send ↷"| RA1

        RA_DETAIL["Phase 1: Reduce-Scatter<br/>N-1 steps, each GPU receives partial sum<br/>Sent per GPU: (N-1)/N × P bytes<br/><br/>Phase 2: All-Gather<br/>N-1 steps, each GPU broadcasts its shard<br/>Sent per GPU: (N-1)/N × P bytes<br/><br/>Total: 2(N-1)/N × P bytes per GPU<br/>Latency: 2(N-1) × (α + Pβ/N)"]
    end

    subgraph BUBBLE["Pipeline Bubble"]
        direction TB

        subgraph GPIPE_BUBBLE["GPipe Schedule"]
            GPIPE_VIS["M=microbatches, S=stages<br/>Bubble ratio = (S-1)/(M+S-1)<br/>Example: M=8, S=4 → 3/11 = 27.3% bubble<br/>Example: M=128, S=4 → 3/131 = 2.3% bubble"]
        end

        subgraph ONEF1B_BUBBLE["1F1B Schedule"]
            F1B_VIS["Warmup: inject S-1 forwards on stage 0<br/>Steady: alternate 1F + 1B per stage<br/>Cooldown: drain remaining backwards<br/>Same bubble ratio as GPipe<br/>Memory: O(1) peak activations vs O(M)"]
        end
    end

    subgraph MOE["MoE All-to-All Communication"]
        direction LR
        M1["Expert 0<br/>GPU 0"] -->|"tokens →"| M2["Expert 1<br/>GPU 1"]
        M2 -->|"tokens →"| M3["Expert 2<br/>GPU 2"]
        M3 -->|"tokens →"| M4["Expert 3<br/>GPU 3"]
        M4 -->|"tokens →"| M1

        MOE_DETAIL["Gating: each token selects top-k experts<br/>All-to-All Dispatch: route tokens to expert GPUs<br/>Expert Compute: each expert processes its tokens<br/>All-to-All Combine: route results back<br/>Communication: N-way All-to-All<br/>Load balancing: auxiliary loss for uniform routing"]
    end

    style CLUSTER fill:#e3f2fd,stroke:#1565c0
    style PARALLEL fill:#fff3e0,stroke:#ef6c00
    style RING_ALLREDUCE fill:#fce4ec,stroke:#c62828
    style BUBBLE fill:#e8f5e9,stroke:#2e7d32
    style MOE fill:#f3e5f5,stroke:#7b1fa2
    style TP fill:#e1f5fe,stroke:#0277bd
    style PP fill:#fff8e1,stroke:#f57f17
    style DP fill:#e8eaf6,stroke:#283593
