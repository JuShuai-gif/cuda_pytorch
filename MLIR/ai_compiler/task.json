{
  "project": "edge_ai_compiler_pro",
  "description": "Production-oriented MLIR-based AI compiler stack targeting edge / robotics / VLA deployment.",
  "root": "/home/ghr/code/cuda_pytorch/mlir/ai_compiler",
  "language_policy": {
    "english": ["directories", "filenames", "identifiers", "build_scripts", "cmake", "top_level_docs"],
    "chinese": ["notes/*.md", "source_code_comments", "design_explanations"]
  },
  "build_environment": {
    "llvm_mlir_version": "23.0.0git",
    "mlir_dir": "/home/ghr/code/llvm-project/install/lib/cmake/mlir",
    "llvm_dir": "/home/ghr/code/llvm-project/install/lib/cmake/llvm",
    "build_mode": "Release+Asserts",
    "cxx_standard": 20,
    "rtti": false,
    "exceptions": false,
    "asan_baked_in": false,
    "asan_policy": "opt-in CMake option EDGE_ENABLE_ASAN, default OFF",
    "linker": "lld (-fuse-ld=lld)",
    "compiler": "clang-18.1.3",
    "static_libs": true,
    "available_dialects": ["arith","func","linalg","tensor","memref","affine","scf","bufferization","tosa","quant","vector","llvm","transform","shape","cf","index","math"]
  },
  "global_pipeline": [
    "PyTorch", "ONNX", "ONNX Importer", "MLIR ONNX/Tosa Dialect", "EdgeDialect",
    "Optimization Passes", "Linalg Dialect", "Bufferization", "MemRef Dialect",
    "Affine / SCF", "LLVM Dialect", "LLVM IR", "Backend Runtime", "Execution", "Profiling"
  ],
  "modules": [
    {
      "id": "01", "name": "mlir_fundamentals", "status": "done",
      "topics": ["Operation","Region","Block","Attribute","Type","SSA"],
      "deliverables": ["tools/edge-introspect (IR traversal/print/analysis)", "notes/01_mlir_fundamentals.md"],
      "depends_on": ["build_system"]
    },
    {
      "id": "02", "name": "tablegen_ods", "status": "done",
      "topics": ["ODS","TableGen","generated code analysis"],
      "deliverables": ["src/EdgeDialect/*.td", "notes/02_tablegen_ods.md", "docs/generated_code_walkthrough.md"],
      "depends_on": ["build_system"]
    },
    {
      "id": "03", "name": "edge_dialect", "status": "done",
      "topics": ["Dialect Registration","Custom Type","Custom Attribute","Custom Operation"],
      "ops": ["ConvOp","MatmulOp","ReluOp","AttentionOp","BatchNormOp","ConvBnReluOp","ConstantOp"],
      "deliverables": ["src/EdgeDialect/EdgeDialect.{td,cpp}", "src/EdgeDialect/EdgeOps.{td,h,cpp}", "tools/edge-opt", "tests/Dialect/edge-roundtrip.mlir", "notes/03_edge_dialect.md"],
      "depends_on": ["build_system","02"]
    },
    {
      "id": "04", "name": "pass_manager", "status": "done",
      "topics": ["Analysis Pass","Transform Pass","PassManager"],
      "passes": ["ShapeInferencePass","StatisticsPass","IRPrinterPass"],
      "deliverables": ["src/Transforms/ShapeInference.cpp","src/Transforms/Statistics.cpp","notes/04_pass_manager.md","tests/Transforms/shape-inference.mlir"],
      "depends_on": ["03"]
    },
    {
      "id": "05", "name": "graph_optimization", "status": "done",
      "passes": ["ConvBnReluFusion","ConstantFolding","DeadCodeElimination","CSE","GraphSimplification"],
      "deliverables": ["src/Transforms/ConvBnReluFusion.cpp","src/Transforms/*","reports/optimization_report.md","notes/05_graph_optimization.md","tests/Transforms/conv-bn-relu-fusion.mlir"],
      "depends_on": ["03","06"]
    },
    {
      "id": "06", "name": "rewrite_patterns", "status": "done",
      "topics": ["Canonicalization","Rewrite Engine","ConversionPattern"],
      "deliverables": ["src/Transforms/Canonicalize*","src/Conversion/*","notes/06_rewrite_patterns.md","tests/Transforms/canonicalize.mlir"],
      "depends_on": ["03"]
    },
    {
      "id": "07", "name": "quantization", "status": "done",
      "topics": ["PTQ","Calibration","MinMax","KL Divergence","Percentile","Mixed Precision"],
      "deliverables": ["src/Quantization/*","tools/edge-quantize","reports/{accuracy,latency,quantization}_report.md","notes/07_quantization.md"],
      "depends_on": ["03","04"]
    },
    {
      "id": "08", "name": "bufferization", "status": "done",
      "topics": ["Tensor->MemRef","Buffer Allocation","Memory Reuse"],
      "deliverables": ["src/Transforms/BufferizationPipeline.cpp","notes/08_bufferization.md","tests/Transforms/bufferize.mlir"],
      "depends_on": ["10"]
    },
    {
      "id": "09", "name": "memory_planner", "status": "done",
      "topics": ["Tensor Lifetime","Buffer Reuse","Memory Sharing","Graph Coloring"],
      "deliverables": ["src/MemoryPlanner/*","reports/{peak_memory,memory_optimization}_report.md","notes/09_memory_planner.md"],
      "depends_on": ["08"]
    },
    {
      "id": "10", "name": "lowering_pipeline", "status": "done",
      "topics": ["Edge->Linalg->MemRef->Affine->LLVM"],
      "deliverables": ["src/Conversion/EdgeToLinalg/*","src/Conversion/Pipeline.cpp","tools/edge-compile","notes/10_lowering_pipeline.md","tests/Conversion/edge-to-linalg.mlir"],
      "depends_on": ["03","06"]
    },
    {
      "id": "11", "name": "runtime_engine", "status": "done",
      "topics": ["ExecutionContext","GraphExecutor","OperatorScheduler","AsyncExecution"],
      "deliverables": ["src/Runtime/*","tools/edge-run","notes/11_runtime_engine.md"],
      "depends_on": ["10"]
    },
    {
      "id": "12", "name": "profiler", "status": "done",
      "topics": ["Latency Breakdown","Memory Breakdown","Timeline","Execution Trace"],
      "deliverables": ["src/Profiler/*","reports/profiling_report.md","notes/12_profiler.md"],
      "depends_on": ["11"]
    },
    {
      "id": "13", "name": "tpu_mlir_analysis", "status": "done",
      "deliverables": ["notes/13_tpu_mlir_analysis.md","docs/comparison_tpu_mlir.md"],
      "depends_on": []
    },
    {
      "id": "14", "name": "tensorrt_analysis", "status": "done",
      "deliverables": ["notes/14_tensorrt_analysis.md"],
      "depends_on": []
    },
    {
      "id": "15", "name": "ascend_cann_analysis", "status": "done",
      "deliverables": ["notes/15_ascend_cann_analysis.md"],
      "depends_on": []
    },
    {
      "id": "16", "name": "end_to_end_compiler", "status": "done",
      "deliverables": ["tools/edge-compiler (driver)","examples/end_to_end/*","reports/{fusion,compilation,latency,memory}_report.md","notes/16_end_to_end.md"],
      "depends_on": ["05","07","09","10","11","12"]
    },
    {
      "id": "17", "name": "robot_vla_deployment", "status": "done",
      "deliverables": ["notes/17_robot_vla_deployment.md","docs/vla_deployment.md","examples/vla/*"],
      "depends_on": ["16"]
    }
  ],
  "cross_cutting": {
    "tests": ["lit", "FileCheck", "GoogleTest"],
    "benchmarks": ["compilation_time","optimization_time","runtime_latency","throughput","memory_usage"],
    "docs": ["README.md","ROADMAP.md","ARCHITECTURE.md","INTERVIEW_GUIDE.md"]
  },
  "note_template_sections": [
    "中文原理讲解", "工业背景", "TensorRT 对应模块", "TVM 对应模块",
    "TPU-MLIR 对应模块", "Ascend CANN 对应模块", "性能收益", "Trade-off",
    "常见 Bug", "调试方法", "Profiling 方法", "在机器人/VLA中的应用"
  ]
}
